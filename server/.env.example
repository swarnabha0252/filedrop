APP_ENV=development

# Local development database URL
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/filedrop

# Optional: Unpooled/direct connection for migrations (required for Neon in production)
# For local dev, can be same as DATABASE_URL or omitted
DATABASE_URL_UNPOOLED=

MAX_FILE_SIZE_MB=100

FRONTEND_URL=http://localhost:5173

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

ALLOWED_ORIGINS=http://localhost:5173

TOKEN_LENGTH=24

CLEANUP_INTERVAL_SECONDS=3600

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Production (Vercel + Neon) - automatically provided by Vercel:
# DATABASE_DATABASE_URL         - Pooled connection for application runtime
# DATABASE_DATABASE_URL_UNPOOLED - Direct connection for migrations/DDL
# DATABASE_POSTGRES_URL_NON_POOLING - Alternative direct connection
# DATABASE_POSTGRES_PRISMA_URL    - Prisma-optimized pooled connection
# DATABASE_POSTGRES_URL_NO_SSL    - Non-SSL pooled connection